{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex-Debug: Remote (Anhui ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "100.79.218.27:33333",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/debug_GCC_STM32C562CET6/a26092701.elf",
            "armToolchainPath": "C:/ST/STM32CubeCLT_1.20.0/GNU-tools-for-STM32/bin",
            "preLaunchTask": "STM32: Build",
            "runToEntryPoint": "main",
            "overrideLaunchCommands": [
                "target remote 100.79.218.27:33333",
                "monitor reset",
                "load",
                "monitor reset"
            ]
        },
        {
            "name": "C/C++ GDB: Remote (Anhui ST-Link)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug_GCC_STM32C562CET6/a26092701.elf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/ST/STM32CubeCLT_1.20.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            "miDebuggerServerAddress": "100.79.218.27:33333",
            "targetArchitecture": "arm",
            "preLaunchTask": "STM32: Build",
            "customLaunchSetupCommands": [
                {
                    "text": "target remote 100.79.218.27:33333",
                    "description": "Connect to GDB Server in Anhui",
                    "ignoreFailures": false
                },
                {
                    "text": "monitor reset",
                    "description": "Reset MCU",
                    "ignoreFailures": true
                },
                {
                    "text": "load",
                    "description": "Download binary to flash",
                    "ignoreFailures": false
                },
                {
                    "text": "monitor reset",
                    "description": "Reset MCU after download",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch ST-Link GDB Server (Local)",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ]
        }
    ]
}
